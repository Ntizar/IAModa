# Copia este fichero a .env y rellena los valores.
# .env NUNCA se commitea: está en .gitignore.

# Telegram (BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# GitHub (scope repo) — solo si el agente va a hacer push por ti
GITHUB_TOKEN=

# Zona horaria del sistema
HERMES_TIMEZONE=Europe/Madrid
